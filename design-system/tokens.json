      "$value": "#f5f5f524",
      "$description": "The same capsule hovered or open: text at 14%.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#f5f5f524",
          "light": "#14141424",
          "whatsapp-dark": "#e9edef24",
          "whatsapp-light": "#111b2124",
          "messages-dark": "#f5f5f724",
          "messages-light": "#1d1d1f24",
          "halloween-dark": "#fff3e824",
          "halloween-light": "#2b140824"
        }
      }
    },
    "tint-hover": {

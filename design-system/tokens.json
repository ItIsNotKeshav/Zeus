{
  "$description": "Zeus design tokens (DTCG format). Generated from src/theme.rs; see design-system/README.md.",
  "color": {
    "window": {
      "$type": "color",
      "$value": "#080808",
      "$description": "The window's broadest ground, behind the chat list and the conversation card.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#080808",
          "light": "#f7f7f7",
          "whatsapp-dark": "#0b141a",
          "whatsapp-light": "#f0f2f5",
          "messages-dark": "#1e1e1e",
          "messages-light": "#ffffff",
          "halloween-dark": "#0b0609",
          "halloween-light": "#fbe9d3"
        }
      }
    },
    "panel": {
      "$type": "color",
      "$value": "#131313",
      "$description": "Sidebars, the settings rail and egui panels. Under a desktop backdrop the chat list thins it (210/230 alpha).",
      "$extensions": {
        "zeus.themes": {
          "dark": "#131313",
          "light": "#ffffff",
          "whatsapp-dark": "#111b21",
          "whatsapp-light": "#ffffff",
          "messages-dark": "#262627",
          "messages-light": "#f2f2f4",
          "halloween-dark": "#170d12",
          "halloween-light": "#fff6ea"
        }
      }
    },
    "surface": {
      "$type": "color",
      "$value": "#222222",
      "$description": "Inline fields, inactive egui widgets, cards that sit on the panel.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#222222",
          "light": "#efefef",
          "whatsapp-dark": "#202c33",
          "whatsapp-light": "#f0f2f5",
          "messages-dark": "#323234",
          "messages-light": "#e8e8ea",
          "halloween-dark": "#28171d",
          "halloween-light": "#ffe6cc"
        }
      }
    },
    "surface-hover": {
      "$type": "color",
      "$value": "#303030",
      "$description": "A hovered row, menu item or widget. Never the only sign of selection.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#303030",
          "light": "#e4e4e4",
          "whatsapp-dark": "#2a3942",
          "whatsapp-light": "#e6e9ec",
          "messages-dark": "#3a3a3c",
          "messages-light": "#dedee0",
          "halloween-dark": "#362029",
          "halloween-light": "#ffdab5"
        }
      }
    },
    "surface-active": {
      "$type": "color",
      "$value": "#3b3b3b",
      "$description": "A pressed widget, a selected row on opaque themes, the off track of a switch.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#3b3b3b",
          "light": "#d8d8d8",
          "whatsapp-dark": "#35444d",
          "whatsapp-light": "#d9dde1",
          "messages-dark": "#464649",
          "messages-light": "#d1d1d6",
          "halloween-dark": "#442b35",
          "halloween-light": "#ffcc99"
        }
      }
    },
    "outline": {
      "$type": "color",
      "$value": "#353535",
      "$description": "1px strokes: menu and dialog edges, separators, the egui window stroke.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#353535",
          "light": "#d9d9d9",
          "whatsapp-dark": "#222d34",
          "whatsapp-light": "#e9edef",
          "messages-dark": "#38383a",
          "messages-light": "#d8d8dc",
          "halloween-dark": "#4a3039",
          "halloween-light": "#f0c79d"
        }
      }
    },
    "text": {
      "$type": "color",
      "$value": "#f5f5f5",
      "$description": "Primary text and icons on every ground above. Also the base of every tint-* token.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#f5f5f5",
          "light": "#141414",
          "whatsapp-dark": "#e9edef",
          "whatsapp-light": "#111b21",
          "messages-dark": "#f5f5f7",
          "messages-light": "#1d1d1f",
          "halloween-dark": "#fff3e8",
          "halloween-light": "#2b1408"
        }
      }
    },
    "secondary": {
      "$type": "color",
      "$value": "#b8b8b8",
      "$description": "Supporting text: descriptions, timestamps, menu icons. Meets 4.5:1 on window, panel, surface and menus.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#b8b8b8",
          "light": "#5e5e5e",
          "whatsapp-dark": "#97a5ae",
          "whatsapp-light": "#515f67",
          "messages-dark": "#aeaeb2",
          "messages-light": "#5e5e63",
          "halloween-dark": "#e3c7b6",
          "halloween-light": "#6a4630"
        }
      }
    },
    "dim": {
      "$type": "color",
      "$value": "#9b9b9b",
      "$description": "Lowest-priority metadata, disabled labels, muted badges. Meets 4.5:1 on the same grounds as secondary.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#9b9b9b",
          "light": "#6b6b6b",
          "whatsapp-dark": "#8a989f",
          "whatsapp-light": "#636b72",
          "messages-dark": "#a4a4a9",
          "messages-light": "#646469",
          "halloween-dark": "#bc9d8c",
          "halloween-light": "#7d5a44"
        }
      }
    },
    "accent": {
      "$type": "color",
      "$value": "#f4f4f4",
      "$description": "Primary buttons, switches on, unread badges, focus rings, the text cursor. In Dark it is near-white: Zeus's default is monochrome.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#f4f4f4",
          "light": "#1a1a1a",
          "whatsapp-dark": "#00a884",
          "whatsapp-light": "#008069",
          "messages-dark": "#0091ff",
          "messages-light": "#0088ff",
          "halloween-dark": "#ff7a1a",
          "halloween-light": "#d96816"
        }
      }
    },
    "accent-hover": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Hovered primary button and accent fills.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#ffffff",
          "light": "#363636",
          "whatsapp-dark": "#06cf9c",
          "whatsapp-light": "#006e5a",
          "messages-dark": "#409cff",
          "messages-light": "#0068da",
          "halloween-dark": "#ff9548",
          "halloween-light": "#b85813"
        }
      }
    },
    "on-accent": {
      "$type": "color",
      "$value": "#121212",
      "$description": "Text and icons drawn on an accent fill, and the focus ring over one.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#121212",
          "light": "#ffffff",
          "whatsapp-dark": "#0b141a",
          "whatsapp-light": "#ffffff",
          "messages-dark": "#ffffff",
          "messages-light": "#ffffff",
          "halloween-dark": "#ffffff",
          "halloween-light": "#ffffff"
        }
      }
    },
    "danger": {
      "$type": "color",
      "$value": "#f15c6d",
      "$description": "Destructive actions, errors, the recording light. Always paired with a label or icon.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#f15c6d",
          "light": "#ea0038",
          "whatsapp-dark": "#f15c6d",
          "whatsapp-light": "#ea0038",
          "messages-dark": "#ff453a",
          "messages-light": "#d70015",
          "halloween-dark": "#f15c6d",
          "halloween-light": "#ea0038"
        }
      }
    },
    "warning": {
      "$type": "color",
      "$value": "#ffd279",
      "$description": "Cautions and degraded states. Always paired with a label or icon.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#ffd279",
          "light": "#a06b00",
          "whatsapp-dark": "#ffd279",
          "whatsapp-light": "#a06b00",
          "messages-dark": "#ffd60a",
          "messages-light": "#a05a00",
          "halloween-dark": "#ffd279",
          "halloween-light": "#a06b00"
        }
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "#1a1a1a",
      "$description": "The opaque fill of menus, dialogs and toasts. With Blur on they use menu-glass instead.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#1a1a1a",
          "light": "#ffffff",
          "whatsapp-dark": "#233138",
          "whatsapp-light": "#ffffff",
          "messages-dark": "#2c2c2e",
          "messages-light": "#ffffff",
          "halloween-dark": "#1f1218",
          "halloween-light": "#fffaf3"
        }
      }
    },
    "chat": {
      "$type": "color",
      "$value": "#0d0d0d",
      "$description": "The conversation background behind the bubbles and the doodle wallpaper.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#0d0d0d",
          "light": "#f7f7f7",
          "whatsapp-dark": "#0b141a",
          "whatsapp-light": "#efeae2",
          "messages-dark": "#1e1e1e",
          "messages-light": "#ffffff",
          "halloween-dark": "#100a0e",
          "halloween-light": "#ffefdb"
        }
      }
    },
    "bubble-in": {
      "$type": "color",
      "$value": "#252525",
      "$description": "Incoming message bubbles. Text on it is `text` at 4.5:1 or better.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#252525",
          "light": "#ffffff",
          "whatsapp-dark": "#202c33",
          "whatsapp-light": "#ffffff",
          "messages-dark": "#3b3b3d",
          "messages-light": "#e9e9eb",
          "halloween-dark": "#2b1a22",
          "halloween-light": "#fffdf9"
        }
      }
    },
    "bubble-out": {
      "$type": "color",
      "$value": "#4a4a4a",
      "$description": "Your own message bubbles. Secondary text on it is re-derived to stay at 4.5:1 (Palette::on_bubble).",
      "$extensions": {
        "zeus.themes": {
          "dark": "#4a4a4a",
          "light": "#e2e2e2",
          "whatsapp-dark": "#005c4b",
          "whatsapp-light": "#d9fdd3",
          "messages-dark": "#409cff",
          "messages-light": "#5ac8fa",
          "halloween-dark": "#8a451e",
          "halloween-light": "#ffdcc1"
        }
      }
    },
    "link": {
      "$type": "color",
      "$value": "#d6d6d6",
      "$description": "Links in messages and prose.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#d6d6d6",
          "light": "#353535",
          "whatsapp-dark": "#53bdeb",
          "whatsapp-light": "#027eb5",
          "messages-dark": "#64d2ff",
          "messages-light": "#0066cc",
          "halloween-dark": "#ffa96a",
          "halloween-light": "#ae5312"
        }
      }
    },
    "read": {
      "$type": "color",
      "$value": "#d6d6d6",
      "$description": "The read-receipt ticks. Icons: 3:1 minimum.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#d6d6d6",
          "light": "#353535",
          "whatsapp-dark": "#53bdeb",
          "whatsapp-light": "#027eb5",
          "messages-dark": "#64d2ff",
          "messages-light": "#0066cc",
          "halloween-dark": "#ffa96a",
          "halloween-light": "#ae5312"
        }
      }
    },
    "shadow": {
      "$type": "color",
      "$value": "#0000008c",
      "$description": "The colour of float and modal shadows, and the dialog backdrop.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#0000008c",
          "light": "#00000032",
          "whatsapp-dark": "#0000008c",
          "whatsapp-light": "#00000032",
          "messages-dark": "#00000096",
          "messages-light": "#00000032",
          "halloween-dark": "#0000008c",
          "halloween-light": "#00000032"
        }
      }
    },
    "menu-glass": {
      "$type": "color",
      "$value": "#1a1a1ab0",
      "$description": "Fill of menus, popovers, dialogs and pickers over frosted glass: overlay at 176 (dark) or 200 (light) alpha.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#1a1a1ab0",
          "light": "#ffffffc8",
          "whatsapp-dark": "#233138b0",
          "whatsapp-light": "#ffffffc8",
          "messages-dark": "#2c2c2eb0",
          "messages-light": "#ffffffc8",
          "halloween-dark": "#1f1218b0",
          "halloween-light": "#fffaf3c8"
        }
      }
    },
    "glass": {
      "$type": "color",
      "$value": "#0d0d0de0",
      "$description": "Glass that floats over the conversation: the composer, header pills, day chips.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#0d0d0de0",
          "light": "#f7f7f7ee",
          "whatsapp-dark": "#0b141ab8",
          "whatsapp-light": "#efeae280",
          "messages-dark": "#1e1e1eb8",
          "messages-light": "#ffffff80",
          "halloween-dark": "#100a0ee0",
          "halloween-light": "#ffefdbee"
        }
      }
    },
    "header-veil": {
      "$type": "color",
      "$value": "#0d0d0db8",
      "$description": "The veil of the conversation header over the frosted messages scrolling under it.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#0d0d0db8",
          "light": "#f7f7f7d2",
          "whatsapp-dark": "#0b141a4c",
          "whatsapp-light": "#efeae233",
          "messages-dark": "#1e1e1e4c",
          "messages-light": "#ffffff33",
          "halloween-dark": "#100a0eb8",
          "halloween-light": "#ffefdbd2"
        }
      }
    },
    "glass-edge": {
      "$type": "color",
      "$value": "#f5f5f514",
      "$description": "The faint 1px edge around glass chips and pills: text at 8%.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#f5f5f514",
          "light": "#14141414",
          "whatsapp-dark": "#e9edef14",
          "whatsapp-light": "#111b2114",
          "messages-dark": "#f5f5f714",
          "messages-light": "#1d1d1f14",
          "halloween-dark": "#fff3e814",
          "halloween-light": "#2b140814"
        }

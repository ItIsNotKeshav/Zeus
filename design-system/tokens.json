  "accent-preset": {
    "red": {
      "$type": "color",
      "$value": "#ff453a",
      "$description": "The Red colour theme: Dark with this accent. Buttons and switches take it raw; own bubbles, links and ticks take readable tints of it (Palette::with_accent)."
    },
    "blue": {
      "$type": "color",
      "$value": "#0a84ff",
      "$description": "The Blue colour theme: Dark with this accent. Buttons and switches take it raw; own bubbles, links and ticks take readable tints of it (Palette::with_accent)."
    },
    "green": {
      "$type": "color",
      "$value": "#30d158",
      "$description": "The Green colour theme: Dark with this accent. Buttons and switches take it raw; own bubbles, links and ticks take readable tints of it (Palette::with_accent)."
    },
    "pink": {
      "$type": "color",
      "$value": "#ff378f",
      "$description": "The Pink colour theme: Dark with this accent. Buttons and switches take it raw; own bubbles, links and ticks take readable tints of it (Palette::with_accent)."
    },
    "purple": {
      "$type": "color",
      "$value": "#bf5af2",
      "$description": "The Purple colour theme: Dark with this accent. Buttons and switches take it raw; own bubbles, links and ticks take readable tints of it (Palette::with_accent)."
    },
    "yellow": {
      "$type": "color",
      "$value": "#ffd60a",
      "$description": "The Yellow colour theme: Dark with this accent. Buttons and switches take it raw; own bubbles, links and ticks take readable tints of it (Palette::with_accent)."
    }
  },
  "radius": {
    "bubble-join": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Where two grouped bubbles in one run meet (Dark/Light bubble style)."
    },
    "small": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Badges, thumbnails, swatches, small tiles, the default focus ring."
    },
    "bubble": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "WhatsApp-style text bubbles and dialog row highlights. Bubbles stay tighter than panels on purpose."
    },
    "control": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Buttons and egui's own widgets."
    },
    "medium": {
      "$type": "dimension",
      "$value": "14px",
      "$description": "Fields, list rows, toasts and items inside a menu (menu 20 minus its 6pt margin)."
    },
    "bubble-messages": {
      "$type": "dimension",
      "$value": "15px",
      "$description": "Messages-style balloons, Apple's own continuous shape."
    },
    "bubble-grouped": {
      "$type": "dimension",
      "$value": "18px",
      "$description": "Dark/Light grouped bubbles: the ends of a run."
    },
    "menu": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Menus and popovers, over frosted glass."
    },
    "card": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Settings groups, call tiles, previews."
    },
    "panel": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "The conversation card beside the chat list, and the composer field."
    },
    "dialog": {
      "$type": "dimension",
      "$value": "28px",
      "$description": "Dialogs, emoji and sticker pickers, every large surface floating over the window."
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px",
      "$description": "Capsule controls: pill buttons, dropdowns, text fields, chips, switch tracks."
    }
  },
  "space": {
    "2": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "Hairline gaps: between a title and its subtitle, stacked meta lines."
    },
    "4": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Icon to label, tightly related items, the gap between dialog rows."
    },
    "6": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "egui item spacing (vertical), the menu's inner margin, a popup's gap from its anchor."
    },
    "8": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "egui item spacing (horizontal), compact padding, the gap between list and conversation card."
    },
    "10": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "After each settings row; toast vertical padding."
    },
    "12": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Button horizontal padding, comfortable control padding."
    },
    "14": {
      "$type": "dimension",
      "$value": "14px",
      "$description": "Toast horizontal padding, the composer text padding."
    },
    "16": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Standard panel and window margin; text inset inside a capsule control."
    },
    "20": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Between groups inside a dialog or settings page."
    },
    "22": {
      "$type": "dimension",
      "$value": "22px",
      "$description": "Dialog inner margin."
    },
    "24": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Between major groups, around the settings page."
    },
    "32": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "Large structural separation, used only when the window has room."
    },
    "48": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "Top inset of an empty state."
    }
  },
  "size": {
    "control-height": {
      "$type": "dimension",
      "$value": "36px",
      "$description": "Dropdowns, text fields and composer buttons."
    },
    "control-width": {

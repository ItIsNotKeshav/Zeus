      "$value": "#f5f5f514",
      "$description": "Resting fill of the capsule dropdown and text field: text at 8%.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#f5f5f514",
          "light": "#14141414",
          "whatsapp-dark": "#e9edef14",
          "whatsapp-light": "#111b2114",
          "messages-dark": "#f5f5f714",
          "messages-light": "#1d1d1f14",
          "halloween-dark": "#fff3e814",
          "halloween-light": "#2b140814"
        }
      }
    },
    "tint-field-lift": {

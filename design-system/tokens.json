      "$value": "#f5f5f51f",
      "$description": "Selected list row over a vibrant theme: text at 12%.",
      "$extensions": {
        "zeus.themes": {
          "dark": "#f5f5f51f",
          "light": "#1414141f",
          "whatsapp-dark": "#e9edef1f",
          "whatsapp-light": "#111b211f",

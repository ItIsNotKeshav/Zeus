      "$extensions": {
        "zeus.themes": {
          "dark": "#f5f5f50f",
          "light": "#1414140f",
          "whatsapp-dark": "#e9edef0f",
          "whatsapp-light": "#111b210f",
          "messages-dark": "#f5f5f70f",
          "messages-light": "#1d1d1f0f",
